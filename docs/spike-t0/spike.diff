@@ -0,0 +1,34 @@
+<?php
+
+namespace App\Multitenancy;
+
+/** Solo para el paso 0: marcas de tiempo por etapa. Rama descartable. */
+final class Timing
+{
+    public static array $marks = [];
+
+    private static ?int $last = null;
+
+    public static function start(): void
+    {
+        self::$last = hrtime(true);
+    }
+
+    public static function mark(string $name): void
+    {
+        $now = hrtime(true);
+        self::$marks[$name] = (self::$marks[$name] ?? 0) + ($now - self::$last) / 1e6;
+        self::$last = hrtime(true);
+    }
+
+    public static function header(): string
+    {
+        $parts = [];
+
+        foreach (self::$marks as $name => $ms) {
+            $parts[] = sprintf('%s;dur=%.3f', $name, $ms);
+        }
+
+        return implode(', ', $parts);
+    }
+}
