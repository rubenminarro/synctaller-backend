+<?php
+
+namespace App\Multitenancy;
+
+use Spatie\Multitenancy\Actions\MakeTenantCurrentAction;
+use Spatie\Multitenancy\Contracts\IsTenant;
+use Spatie\Multitenancy\Tasks\SwitchTenantTask;
+
+/** Solo para el paso 0: mide cada tarea de cambio de taller. */
+class TimedMakeTenantCurrentAction extends MakeTenantCurrentAction
+{
+    protected function performTasksToMakeTenantCurrent(IsTenant $tenant): static
+    {
+        $this->tasksCollection->each(function (SwitchTenantTask $task) use ($tenant) {
+            Timing::mark('other');
+            $task->makeCurrent($tenant);
+            Timing::mark('task_' . class_basename($task));
+        });
+
+        return $this;
+    }
+}
