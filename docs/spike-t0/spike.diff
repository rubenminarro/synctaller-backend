--- /dev/null
+++ b/app/Http/Middleware/IdentifyTenant.php
@@ -0,0 +1,56 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Multitenancy\Timing;
+use Closure;
+use Illuminate\Database\Events\QueryExecuted;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Event;
+use Spatie\Multitenancy\TenantFinder\DomainTenantFinder;
+use Symfony\Component\HttpFoundation\Response;
+
+/** Solo para el paso 0: identifica el taller y mide cada etapa. */
+class IdentifyTenant
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $queries = [];
+
+        if ($request->hasHeader('X-Spike-Log')) {
+            Event::listen(QueryExecuted::class, function (QueryExecuted $e) use (&$queries) {
+                $queries[] = $e->connectionName . ' ' . preg_replace('/\s+/', ' ', substr($e->sql, 0, 60));
+            });
+        }
+
+        Timing::start();
+
+        $request->getHost();
+        Timing::mark('host');
+
+        DB::connection('landlord')->getPdo();
+        Timing::mark('landlord_connect');
+
+        $tenant = app(DomainTenantFinder::class)->findForRequest($request);
+        Timing::mark('tenant_lookup');
+
+        abort_if($tenant === null, 404);
+
+        $tenant->makeCurrent();
+        Timing::mark('bind');
+
+        DB::connection()->getPdo();
+        Timing::mark('tenant_connect');
+
+        $response = $next($request);
+
+        $response->headers->set('Server-Timing', Timing::header());
+
+        if ($request->hasHeader('X-Spike-Log')) {
+            $response->headers->set('X-Spike-Queries', json_encode($queries));
+        }
+
+        return $response;
+    }
+}
